<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_dashboard_bridge</name>
  <version>0.1.0</version>
  <description>Stable local API between the Oak Control dashboard and ROS 2.</description>
  <maintainer email="team48@uconn.edu">UConn Team 48</maintainer>
  <license>BSD-2-Clause</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>go2_interfaces</depend>

  <exec_depend>python3-aiohttp</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
